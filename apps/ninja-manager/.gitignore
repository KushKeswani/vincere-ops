/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.next-e2e-central/
/.next-e2e-local/
/.next-seq-*/
/.next-webpack-local/
