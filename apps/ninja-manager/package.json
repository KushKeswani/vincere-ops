{
  "name": "ninja-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "dev": "node scripts/next-runtime.mjs dev",
    "dev:central": "node scripts/next-runtime.mjs dev --mode CENTRAL_CONNECTED",
    "dev:local": "node scripts/next-runtime.mjs dev --mode LOCAL_ONLY",
    "prototype:local": "node scripts/local-prototype.mjs",
    "build": "node scripts/next-runtime.mjs build-all",
    "build:all": "node scripts/next-runtime.mjs build-all",
    "build:central": "node scripts/next-runtime.mjs build --mode CENTRAL_CONNECTED",
    "build:local": "node scripts/next-runtime.mjs build --mode LOCAL_ONLY",
    "start": "node scripts/next-runtime.mjs start",
    "start:central": "node scripts/next-runtime.mjs start --mode CENTRAL_CONNECTED",
    "start:local": "node scripts/next-runtime.mjs start --mode LOCAL_ONLY",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:central": "playwright test --project=central-connected",
    "test:e2e:local": "playwright test --project=local-only",
    "test:listener": "node scripts/verify-local-listener.mjs",
    "test:contract:csharp": "dotnet run --project contracts/runtime-v1/csharp/RuntimeContractVectors.csproj",
    "test:companion": "vitest run src/companion",
    "companion:doctor": "node --import tsx scripts/companion.ts doctor",
    "companion:once": "node --import tsx scripts/companion.ts once",
    "companion:run": "node --import tsx scripts/companion.ts run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:verify": "node scripts/verify-database-gate.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@next/env": "16.2.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "agent-browser": "^0.31.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.17"
  }
}
