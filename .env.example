# Copy to %LocalAppData%\Vincere.Operator\.env or set Windows User/System environment variables (vars override file).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
DATA_DIR=
NT_LOG_DIR=
VINCERE_IPC_PIPE_NAME=VincereOperator
# Named-pipe: timeout per attempt (ms), total attempts, delay between retries (fixes flaky RDP / busy pipe).
VINCERE_IPC_CONNECT_MS=20000
VINCERE_IPC_RETRY_ATTEMPTS=8
VINCERE_IPC_RETRY_DELAY_MS=400
NT_HEALTH_AUTO_RECONNECT=true
NT_HEALTH_RECONNECT_COOLDOWN_MINUTES=5
NT_HEALTH_POLL_SECONDS=15
DRY_RUN=false
# License verification is hidden and non-blocking by default while the WAP/Whop flow is parked.
# Keep the backend settings here so production can re-enable the gate later without shipping API secrets.
VINCERE_LICENSE_UI_ENABLED=false
VINCERE_LICENSE_REQUIRED=false
# Production desktop builds should use the Vercel backend URL only. Do not ship WHOP_API_KEY to clients.
VINCERE_LICENSE_API_URL=
# Local test only. Leave false for client installs.
VINCERE_LICENSE_TEST_MODE=false
VINCERE_LICENSE_KEY=
VINCERE_LICENSE_VERIFIED=false
VINCERE_LICENSE_STATUS=
VINCERE_LICENSE_VERIFIED_AT=
# Optional comma-separated template names for Edit stack template dropdown (merged with NT disk + DB).
NT_TEMPLATE_CHOICES=
# Semicolon-separated extra folders to scan for *.xml template names (in addition to auto ...\NinjaTrader 8\templates).
NT_TEMPLATE_DIRS_EXTRA=
# Set true only if NinjaTrader lives outside Documents — then only NT_TEMPLATE_DIRS_EXTRA dirs are scanned.
NT_TEMPLATE_SCAN_EXTRA_ONLY=false
# Use NinjaTrader Control Center UI automation for Apply to NinjaTrader.
VINCERE_ENABLE_NT_UI_STACK_SETUP=true
PROP_CONNECTION_NAME=
PROP_FIRM=
ACCOUNT_TYPE=
TRADING_PLATFORM=
NT_AUTO_LOGIN_ENABLED=false
NT_LOGIN_USERNAME=
NT_LOGIN_PASSWORD_DPAPI=
NT_SCHEDULED_RESET_ENABLED=false
NT_RESET_INTERVAL_DAYS=7
CONNECTION_REFRESH_TIME=08:20
AUTO_APPLY_STACKS=true
STACK_APPLY_TIME=08:23
ENABLE_ALL_STRATEGIES_TIME=08:25
READY_ALGOS_SCHEDULE_ENABLED=false
READY_ALGOS_TIME=08:00
# Keep false until Add All has been verified cleanly for the client account set.
READY_ALGOS_ENABLE_STRATEGIES=false
VINCERE_USE_UI_STRATEGY_TOGGLE=true
ACCOUNT_CYCLING_ENABLED=true
# Optional yyyy-MM-dd. Blank means cycle starts from setup/create date.
ACCOUNT_CYCLING_START_DATE=
ACCOUNT_CYCLING_INTERVAL_DAYS=14
EOD_CUTOFF_TIME=16:05
CLOSE_ALL_BEFORE_EOD=false
CLOSE_ALL_TIME=16:55
AVOID_OVERNIGHT_HOLDS=true
RISK_LIMIT_SCOPE=Account
DAILY_LOSS_LIMIT=
DAILY_PROFIT_LIMIT=
UNREALIZED_LOSS_LIMIT=
UNREALIZED_PROFIT_LIMIT=
