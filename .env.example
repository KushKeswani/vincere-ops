# Copy to %LocalAppData%\Vincere.Operator\.env or set Windows User/System environment variables (vars override file).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
DATA_DIR=
NT_LOG_DIR=
VINCERE_IPC_PIPE_NAME=VincereOperator
# Named-pipe: timeout per attempt (ms), total attempts, delay between retries (fixes flaky RDP / busy pipe).
VINCERE_IPC_CONNECT_MS=20000
VINCERE_IPC_RETRY_ATTEMPTS=8
VINCERE_IPC_RETRY_DELAY_MS=400
DRY_RUN=false
# Optional comma-separated template names for Edit stack template dropdown (merged with templates in DB).
NT_TEMPLATE_CHOICES=
PROP_CONNECTION_NAME=
DEVELOPER_PASSCODE=
CONNECTION_REFRESH_TIME=08:20
ENABLE_ALL_STRATEGIES_TIME=08:25
EOD_CUTOFF_TIME=16:05
