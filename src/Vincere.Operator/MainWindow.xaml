<Window x:Class="Vincere.Operator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincere Ninja Manager - Kush"
        Icon="Assets/app.ico"
        Height="700"
        Width="1100"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E23"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="ColorBackground" Color="#1E1E23"/>
    <SolidColorBrush x:Key="ColorPanel" Color="#282830"/>
    <SolidColorBrush x:Key="ColorPanelAlt" Color="#202027"/>
    <SolidColorBrush x:Key="ColorLogBackground" Color="#19191E"/>
    <SolidColorBrush x:Key="ColorButtonHover" Color="#373741"/>
    <SolidColorBrush x:Key="ColorSeparator" Color="#3C3C46"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#0096FF"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#32CD32"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#FFC800"/>
    <SolidColorBrush x:Key="ColorError" Color="#DC3232"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#B4B4BE"/>
    <SolidColorBrush x:Key="ColorField" Color="#373741"/>
    <SolidColorBrush x:Key="ColorComboField" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ColorComboText" Color="#1E1E23"/>

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style TargetType="{x:Type Label}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{StaticResource ColorField}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="CaretBrush" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="{StaticResource ColorComboField}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorComboText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Background" Value="{StaticResource ColorComboField}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorComboText}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#A9DEF5"/>
          <Setter Property="Foreground" Value="{StaticResource ColorComboText}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

	    <Style TargetType="{x:Type Button}">
	      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
	      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
	      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
	      <Setter Property="Padding" Value="12,7"/>
	      <Setter Property="MinHeight" Value="32"/>
	      <Setter Property="HorizontalContentAlignment" Value="Center"/>
	      <Setter Property="VerticalContentAlignment" Value="Center"/>
	      <Setter Property="Cursor" Value="Hand"/>
	      <Setter Property="Template">
	        <Setter.Value>
	          <ControlTemplate TargetType="{x:Type Button}">
	            <Border x:Name="Chrome"
	                    Background="{TemplateBinding Background}"
	                    BorderBrush="{TemplateBinding BorderBrush}"
	                    BorderThickness="1">
	              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
	                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
	                                Margin="{TemplateBinding Padding}"/>
	            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ColorButtonHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ColorAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

	    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
	      <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
	      <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
	      <Setter Property="FontWeight" Value="SemiBold"/>
	    </Style>

	    <Style x:Key="ConsoleRailButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
	      <Setter Property="Background" Value="Transparent"/>
	      <Setter Property="BorderBrush" Value="Transparent"/>
	      <Setter Property="HorizontalContentAlignment" Value="Left"/>
	      <Setter Property="Padding" Value="10,9"/>
	      <Setter Property="MinHeight" Value="40"/>
	      <Setter Property="FontSize" Value="14"/>
	    </Style>

	    <Style x:Key="ConsoleRailPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ConsoleRailButton}">
	      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
	      <Setter Property="FontWeight" Value="SemiBold"/>
	    </Style>

	    <Style x:Key="ConnectionCard" TargetType="{x:Type Border}">
	      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
	      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
	      <Setter Property="BorderThickness" Value="1"/>
	      <Setter Property="Padding" Value="14"/>
	      <Setter Property="MinHeight" Value="112"/>
	      <Setter Property="Margin" Value="0,0,0,10"/>
	    </Style>

    <Style x:Key="SideTabItem" TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Width" Value="184"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="8,0,8,6"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource ColorButtonHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource ColorAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
      <Setter Property="Background" Value="{StaticResource ColorBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="Background" Value="{StaticResource ColorLogBackground}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="RowBackground" Value="{StaticResource ColorLogBackground}"/>
      <Setter Property="AlternatingRowBackground" Value="{StaticResource ColorPanelAlt}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Background" Value="{StaticResource ColorLogBackground}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource ColorBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="50"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ColorPanel}" Padding="4,0,12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/logo.png" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Vincere Trading Ninja Manager"
                     Foreground="{StaticResource ColorAccent}"
                     FontSize="12"
                     FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Ellipse Width="11" Height="11" Fill="{StaticResource ColorSuccess}" Margin="0,0,8,0"/>
            <TextBlock Text="NinjaTrader: Managed"
                       Foreground="{StaticResource ColorTextPrimary}"
                       FontSize="13"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Border Background="{StaticResource ColorBackground}" Padding="12,6" Margin="0,0,8,0">
            <TextBlock Text="Bot:" Foreground="{StaticResource ColorTextSecondary}"/>
          </Border>
          <Border Background="{StaticResource ColorBackground}" Padding="12,6">
            <TextBlock x:Name="BotStateText" Text="Stopped" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="LicenseText" Text="License: --" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,20,0"/>
          <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:HH:mm:ss}}"
                     xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                     Foreground="{StaticResource ColorAccent}"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs"
                Grid.Row="1"
                TabStripPlacement="Left"
                Background="{StaticResource ColorBackground}"
                BorderThickness="0"
                Padding="0"
                Margin="0">
      <TabControl.Resources>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource SideTabItem}"/>
      </TabControl.Resources>

	      <TabItem Header="Dashboard">
	        <Grid Background="{StaticResource ColorBackground}">
	          <Grid Margin="0">
	            <Grid.ColumnDefinitions>
	              <ColumnDefinition Width="250"/>
	              <ColumnDefinition Width="*"/>
	              <ColumnDefinition Width="270"/>
	            </Grid.ColumnDefinitions>

	            <Border Background="{StaticResource ColorPanel}" BorderBrush="{StaticResource ColorSeparator}" BorderThickness="0,0,1,0" Padding="14,16">
	              <DockPanel LastChildFill="True">
	                <StackPanel DockPanel.Dock="Top">
	                  <Button x:Name="StartBotBtn"
	                          Style="{StaticResource ConsoleRailPrimaryButton}"
	                          Click="StartBot_Click">
	                    <TextBlock Text="Start Manager"/>
	                  </Button>
	                  <Button x:Name="StopBotBtn"
	                          Style="{StaticResource ConsoleRailButton}"
	                          Click="StopBot_Click"
	                          IsEnabled="False">
	                    <TextBlock Text="Stop Manager"/>
	                  </Button>
	                  <Button Style="{StaticResource ConsoleRailPrimaryButton}" Click="GetAlgosReady_Click">
	                    <TextBlock Text="Get Algos Ready"/>
	                  </Button>

	                  <Border Height="1" Background="{StaticResource ColorSeparator}" Margin="0,12"/>

	                  <Button Style="{StaticResource ConsoleRailButton}" Click="LaunchNinjaTrader_Click">
	                    <TextBlock Text="Start NinjaTrader"/>
	                  </Button>
	                  <Button Style="{StaticResource ConsoleRailButton}" Click="ShutdownNinjaTrader_Click">
	                    <TextBlock Text="Stop NinjaTrader"/>
	                  </Button>

	                  <Border Height="1" Background="{StaticResource ColorSeparator}" Margin="0,12"/>

	                  <Button Style="{StaticResource ConsoleRailButton}" Click="EnableAlgos_Click">
	                    <TextBlock Text="Enable Strategies"/>
	                  </Button>
	                  <Button Style="{StaticResource ConsoleRailButton}" Click="DisableAlgos_Click">
	                    <TextBlock Text="Disable Strategies"/>
	                  </Button>

	                  <Border Height="1" Background="{StaticResource ColorSeparator}" Margin="0,12"/>

	                  <Button Style="{StaticResource ConsoleRailButton}" Click="ConnectPropFirms_Click">
	                    <TextBlock Text="Connect All"/>
	                  </Button>
	                  <Button Style="{StaticResource ConsoleRailButton}" Click="DisconnectPropFirms_Click">
	                    <TextBlock Text="Disconnect All"/>
	                  </Button>

	                  <Border Height="1" Background="{StaticResource ColorSeparator}" Margin="0,12"/>

	                  <Button Style="{StaticResource ConsoleRailButton}" Click="ShowSettings_Click">
	                    <TextBlock Text="Settings"/>
	                  </Button>
	                  <Button Style="{StaticResource ConsoleRailButton}" Click="OpenLogs_Click">
	                    <TextBlock Text="View Logs"/>
	                  </Button>
	                </StackPanel>

	                <TextBlock x:Name="PingResult"
	                           DockPanel.Dock="Bottom"
	                           TextWrapping="Wrap"
	                           Foreground="{StaticResource ColorTextSecondary}"
	                           FontSize="12"
	                           Margin="0,18,0,0"/>
	              </DockPanel>
	            </Border>

	            <Grid Grid.Column="1" Margin="14,12">
	              <Grid.RowDefinitions>
	                <RowDefinition Height="Auto"/>
	                <RowDefinition Height="*"/>
	                <RowDefinition Height="Auto"/>
	              </Grid.RowDefinitions>

	              <Border Background="{StaticResource ColorPanel}" BorderBrush="{StaticResource ColorSeparator}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
	                <DockPanel>
	                  <StackPanel DockPanel.Dock="Left">
	                    <TextBlock Text="Automation Console"
	                               FontSize="17"
	                               FontWeight="SemiBold"/>
	                    <TextBlock Text="Morning enable, prop-firm refresh, blueprint setup, and NinjaTrader health checks"
	                               Foreground="{StaticResource ColorTextSecondary}"
	                               TextWrapping="Wrap"
	                               Margin="0,4,0,0"/>
	                  </StackPanel>
	                  <TextBlock x:Name="DryRunText"
	                             DockPanel.Dock="Right"
	                             Foreground="{StaticResource ColorWarning}"
	                             TextWrapping="Wrap"
	                             TextAlignment="Right"
	                             Margin="12,0,0,0"/>
	                </DockPanel>
	              </Border>

	              <Border Grid.Row="1" Background="{StaticResource ColorLogBackground}" BorderBrush="{StaticResource ColorSeparator}" BorderThickness="1" Padding="12">
	                <ScrollViewer VerticalScrollBarVisibility="Auto">
	                  <StackPanel>
	                    <TextBlock FontFamily="Consolas"
	                               FontSize="12"
	                               Foreground="{StaticResource ColorAccent}"
	                               TextWrapping="Wrap"
	                               Text="Vincere Ninja Manager console ready. Use the action rail to run live NinjaTrader automation."/>
	                    <TextBlock FontFamily="Consolas"
	                               FontSize="12"
	                               Foreground="{StaticResource ColorSuccess}"
	                               TextWrapping="Wrap"
	                               Margin="0,6,0,10"
	                               Text="Health checks monitor chart freezes, stale data, disconnects, and broker feed failures."/>
	                    <TextBlock x:Name="IpcHintText"
	                               TextWrapping="Wrap"
	                               Foreground="{StaticResource ColorAccent}"
	                               FontFamily="Consolas"
	                               FontSize="12"/>
	                    <TextBlock x:Name="ReadyAlgosStatusText"
	                               TextWrapping="Wrap"
	                               Foreground="{StaticResource ColorWarning}"
	                               FontFamily="Consolas"
	                               FontSize="12"
	                               Margin="0,8,0,0"/>
	                  </StackPanel>
	                </ScrollViewer>
	              </Border>

	              <Border Grid.Row="2" Background="{StaticResource ColorPanel}" BorderBrush="{StaticResource ColorSeparator}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
	                <TextBlock x:Name="PathsText"
	                           TextWrapping="Wrap"
	                           Foreground="{StaticResource ColorTextSecondary}"
	                           FontSize="12"/>
	              </Border>
	            </Grid>

	            <Border Grid.Column="2"
	                    Background="{StaticResource ColorPanelAlt}"
	                    BorderBrush="{StaticResource ColorSeparator}"
	                    BorderThickness="1,0,0,0"
	                    Padding="16,14">
	              <StackPanel>
	                <TextBlock Text="Connections"
	                           Foreground="{StaticResource ColorAccent}"
	                           FontSize="16"
	                           FontWeight="SemiBold"
	                           Margin="0,0,0,12"/>
	                <Border Style="{StaticResource ConnectionCard}">
	                  <StackPanel>
	                    <TextBlock Text="Apex" FontWeight="SemiBold" FontSize="14"/>
	                    <TextBlock Text="Awaiting data"
	                               Foreground="{StaticResource ColorAccent}"
	                               Margin="0,8,0,0"/>
	                  </StackPanel>
	                </Border>
	                <Border Style="{StaticResource ConnectionCard}">
	                  <StackPanel>
	                    <TextBlock Text="Lucid" FontWeight="SemiBold" FontSize="14"/>
	                    <TextBlock Text="Awaiting data"
	                               Foreground="{StaticResource ColorAccent}"
	                               Margin="0,8,0,0"/>
	                  </StackPanel>
	                </Border>
	              </StackPanel>
	            </Border>
	          </Grid>

	        </Grid>
	      </TabItem>

      <TabItem Header="Accounts">
        <Grid Background="{StaticResource ColorBackground}" Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource ColorPanel}" Padding="10" Margin="0,0,10,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top"
                         Text="Accounts"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Margin="0,0,0,8"/>
              <ListBox x:Name="AccountList"
                       DisplayMemberPath="DisplayName"
                       SelectionChanged="AccountList_SelectionChanged"/>
            </DockPanel>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource ColorPanel}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="AccountPnlSummaryText"
                           Text="Select an account to view PnL."
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="AccountAlgoSummaryText"
                           Text="Attached algos will show below."
                           Foreground="{StaticResource ColorTextSecondary}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource ColorLogBackground}" Padding="10" Margin="0,0,0,10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="PnL History"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,8"/>
                <DataGrid x:Name="PerfGrid" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Date (Eastern)" Binding="{Binding DateEastern}" Width="*"/>
                    <DataGridTextColumn Header="PnL" Binding="{Binding Pnl, StringFormat=C}" Width="*"/>
                    <DataGridTextColumn Header="Trades" Binding="{Binding TradeCount}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource ColorLogBackground}" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Algos Attached to Account"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,8"/>
                <DataGrid x:Name="AccountAlgoGrid" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IncludeInApply}" Width="60"/>
                    <DataGridTextColumn Header="Period" Binding="{Binding TradingPeriod}" Width="90"/>
                    <DataGridTextColumn Header="Algo" Binding="{Binding StrategyTypeName}" Width="*"/>
                    <DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" Width="110"/>
                    <DataGridTextColumn Header="Template" Binding="{Binding TemplateName}" Width="2*"/>
                    <DataGridTextColumn Header="Account Attach" Binding="{Binding AccountAttachment}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="EditStackTab" Header="Edit Stack">
        <Grid Background="{StaticResource ColorBackground}" Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Background="{StaticResource ColorPanel}" Padding="10" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Select account" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="StackAccountCombo"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="StackAccountCombo_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Previous Account"
                          Click="PreviousStackAccount_Click"
                          Width="120"
                          Margin="0,0,8,0"/>
                  <Button Content="Next Account"
                          Click="NextStackAccount_Click"
                          Width="100"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Apply to NT" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ApplyFilterCombo" Width="260" HorizontalAlignment="Left"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Content="Refresh Templates"
                      Click="RefreshNtTemplates_Click"
                      VerticalAlignment="Bottom"/>
            </Grid>
          </Border>

          <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="?"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="0,0,8,0"
                    Click="TemplateInfo_Click"
                    ToolTip="Template version guidance"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource ColorTextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="Apply / Period controls what is sent to NinjaTrader. Templates come from .env, NinjaTrader template XML files, and saved stacks."/>
          </DockPanel>

          <DataGrid x:Name="StackGrid"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CellEditEnding="StackGrid_CellEditEnding">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IncludeInApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
              <DataGridTemplateColumn Header="Period" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox SelectedValue="{Binding TradingPeriod, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              ItemsSource="{Binding DataContext.PeriodChoices, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Strategy type" Binding="{Binding StrategyTypeName}" Width="*"/>
              <DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" Width="110"/>
              <DataGridTemplateColumn Header="Template" MinWidth="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox IsEditable="True"
                              DropDownOpened="TemplateCombo_DropDownOpened"
                              Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Instance label" Binding="{Binding InstanceLabel}" Width="*"/>
              <DataGridTextColumn Header="Account attach" Binding="{Binding AccountAttachment}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add Row" Click="AddStackRow_Click" Margin="0,0,8,0"/>
            <Button Content="Delete Selected" Click="DeleteStackRow_Click" Margin="0,0,8,0"/>
            <Button Content="Save Stack" Click="SaveStack_Click" Margin="0,0,8,0"/>
            <Button Content="Add Selected Account" Click="ApplyStack_Click" Margin="0,0,8,0"/>
            <Button Content="Add All to NinjaTrader" Style="{StaticResource AccentButton}" Click="ApplyAllStacks_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem x:Name="BlueprintImportTab" Header="Blueprint Import">
        <Grid Background="{StaticResource ColorBackground}" Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Background="{StaticResource ColorPanel}" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="Choose Blueprint .xlsx"
                        Click="PickExcel_Click"
                        HorizontalAlignment="Left"
                        Style="{StaticResource AccentButton}"/>
                <Button Content="Get your blueprint built here"
                        Click="OpenAccountCyclingBlueprint_Click"
                        Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="Optional spreadsheet column: Period (Period 1 / Period 2 / P1 / P2). Missing periods default to Period 1; missing templates default to Low Risk v1."
                         FontSize="12"
                         Margin="0,8,0,0"
                         Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBlock x:Name="BlueprintImportStatusText"
                         Text="Step 1: choose a blueprint. Step 2: map each blueprint account to the NinjaTrader account. Step 3: save setup. Step 4: review each account in Edit Stack. Step 5: Add All to NinjaTrader."
                         FontSize="12"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource ColorTextSecondary}"/>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ExcelMappingItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Raw}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding AccountChoices}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" Background="{StaticResource ColorPanel}" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ReplaceStacks"
                        Content="Replace existing stack for matched accounts"
                        IsChecked="True"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"/>
              <Button Content="Save Account Setup" Click="ImportExcel_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <Grid Background="{StaticResource ColorBackground}" Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Background="{StaticResource ColorPanel}" Padding="14" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Prop Firm Setup"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Margin="0,0,0,10"/>
              <TextBlock Text="Vincere / Whop license key" Foreground="{StaticResource ColorTextSecondary}"/>
              <Grid Margin="0,3,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SettingsLicenseKeyBox"/>
                <Button Grid.Column="1"
                        Content="Test License Key"
                        Click="VerifyLicense_Click"
                        Width="145"
                        Margin="8,0,0,0"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Reset invalid key"
                        Click="OpenLicenseResetHelp_Click"
                        Width="140"/>
              </StackPanel>
              <TextBlock x:Name="SettingsLicenseStatusText"
                         Text="License not verified."
                         Foreground="{StaticResource ColorTextSecondary}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"/>
              <TextBlock Text="Prop firm" Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBox x:Name="PropFirmBox" Margin="0,3,0,8"/>
              <TextBlock Text="Account type" Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBox x:Name="AccountTypeBox" Margin="0,3,0,8"/>
              <TextBlock Text="Trading platform" Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBox x:Name="TradingPlatformBox" Margin="0,3,0,8"/>
              <Separator Background="{StaticResource ColorSeparator}" Margin="0,6,0,10"/>
              <TextBlock Text="Optional NinjaTrader Login"
                         FontWeight="SemiBold"
                         Margin="0,0,0,6"/>
              <CheckBox x:Name="NinjaTraderAutoLoginCheck"
                        Content="Automatically open NinjaTrader and attempt login"
                        Margin="0,0,0,8"/>
              <TextBlock Text="Optional: only enable this when the client wants hands-off startup. The password is encrypted for this Windows user."
                         Foreground="{StaticResource ColorWarning}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Margin="0,0,0,8"/>
              <TextBlock Text="NinjaTrader username" Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBox x:Name="NinjaTraderUsernameBox" Margin="0,3,0,8"/>
              <TextBlock Text="NinjaTrader password" Foreground="{StaticResource ColorTextSecondary}"/>
              <PasswordBox x:Name="NinjaTraderPasswordBox"
                           Background="{StaticResource ColorField}"
                           Foreground="{StaticResource ColorTextPrimary}"
                           BorderBrush="{StaticResource ColorSeparator}"
                           Padding="8,5"
                           MinHeight="30"
                           Margin="0,3,0,6"/>
              <CheckBox x:Name="NinjaTraderScheduledResetCheck"
                        Content="Schedule NinjaTrader reset"
                        Margin="0,4,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Reset every"
                           Foreground="{StaticResource ColorTextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="NinjaTraderResetDaysBox"
                         Width="60"
                         Margin="0,0,8,0"/>
                <TextBlock Text="day(s)"
                           Foreground="{StaticResource ColorTextSecondary}"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Scheduled reset shuts down and relaunches NinjaTrader during the morning automation window. Optional login is used only if enabled above."
                         Foreground="{StaticResource ColorTextSecondary}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Margin="0,0,0,8"/>
              <Button Content="Test Optional NT Login"
                      Click="TestNinjaTraderLogin_Click"
                      Width="170"
                      Margin="0,0,0,10"/>
              <Separator Background="{StaticResource ColorSeparator}" Margin="0,6,0,10"/>
              <TextBlock Text="Get Algos Ready Schedule"
                         FontWeight="SemiBold"
                         Margin="0,0,0,6"/>
              <CheckBox x:Name="ReadyAlgosScheduleCheck"
                        Content="Automatically get algos ready each trading day"
                        Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Ready time"
                           Foreground="{StaticResource ColorTextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="ReadyAlgosTimeBox"
                         Width="80"
                         Margin="0,0,8,0"/>
                <TextBlock Text="Eastern"
                           Foreground="{StaticResource ColorTextSecondary}"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="At this time the manager disconnects and reconnects selected prop firms, applies the active saved stack, then enables strategies."
                         Foreground="{StaticResource ColorTextSecondary}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Margin="0,0,0,10"/>
              <TextBlock Text="Selected prop connection(s)" Foreground="{StaticResource ColorTextSecondary}"/>
              <TextBox x:Name="PropConnectionNameBox" Margin="0,3,0,8"/>
              <Button Content="Save Prop Firm Settings"
                      Style="{StaticResource AccentButton}"
                      Click="SavePropFirmSettings_Click"
                      Margin="0,6,0,0"/>
            </StackPanel>
            </ScrollViewer>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource ColorPanel}" Padding="12" Margin="0,0,0,10">
              <DockPanel>
                <Button Content="Scan NinjaTrader"
                        Style="{StaticResource AccentButton}"
                        Click="ScanNinjaTraderSettings_Click"
                        Width="150"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0"/>
                <TextBlock x:Name="SettingsScanStatusText"
                           Text="Scan for available NinjaTrader connections and accounts."
                           Foreground="{StaticResource ColorTextSecondary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
              </DockPanel>
            </Border>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource ColorLogBackground}" Padding="12" Margin="0,0,5,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top"
                             Text="Available Prop Firm Connections"
                             FontWeight="SemiBold"
                             FontSize="15"
                             Margin="0,0,0,8"/>
                  <ListBox x:Name="AvailablePropConnectionsList"
                           SelectionMode="Extended"/>
                </DockPanel>
              </Border>
              <Border Grid.Column="1" Background="{StaticResource ColorLogBackground}" Padding="12" Margin="5,0,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top"
                             Text="Available Accounts"
                             FontWeight="SemiBold"
                             FontSize="15"
                             Margin="0,0,0,8"/>
                  <ListBox x:Name="AvailableNtAccountsList"
                           SelectionMode="Extended"/>
                </DockPanel>
              </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource ColorPanel}" Padding="12" Margin="0,10,0,0">
              <WrapPanel>
                <Button Content="Use Selected Connections"
                        Click="UseSelectedConnections_Click"
                        Width="180"
                        Margin="0,0,8,0"/>
                <Button Content="Import Selected Accounts"
                        Click="ImportSelectedNtAccounts_Click"
                        Width="190"
                        Margin="0,0,8,0"/>
                <Button Content="Save All Settings"
                        Style="{StaticResource AccentButton}"
                        Click="SaveAutomationSettings_Click"
                        Width="140"/>
              </WrapPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

    </TabControl>

    <Border Grid.Row="2" Background="{StaticResource ColorPanel}" Padding="10,0">
      <DockPanel LastChildFill="True">
        <Button Content="Open logs"
                Foreground="{StaticResource ColorAccent}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Width="80"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Click="OpenLogs_Click"
                Margin="0,0,20,0"/>
        <TextBlock Text="vincere-ops"
                   Foreground="{StaticResource ColorTextSecondary}"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Right"/>
        <TextBlock x:Name="StatusText"
                   Text="Ready"
                   Foreground="{StaticResource ColorTextSecondary}"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
