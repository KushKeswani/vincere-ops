<Window x:Class="Vincere.Operator.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincere Ninja Manager - Setup"
        Height="760"
        Width="980"
        MinHeight="680"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E23"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="ColorBackground" Color="#1E1E23"/>
    <SolidColorBrush x:Key="ColorPanel" Color="#282830"/>
    <SolidColorBrush x:Key="ColorPanelAlt" Color="#202027"/>
    <SolidColorBrush x:Key="ColorLogBackground" Color="#19191E"/>
    <SolidColorBrush x:Key="ColorButtonHover" Color="#373741"/>
    <SolidColorBrush x:Key="ColorSeparator" Color="#3C3C46"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#0096FF"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#32CD32"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#FFC800"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#B4B4BE"/>
    <SolidColorBrush x:Key="ColorField" Color="#373741"/>

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style TargetType="{x:Type Label}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
      <Setter Property="Padding" Value="0,0,0,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{StaticResource ColorField}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="CaretBrush" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
      <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ColorButtonHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ColorAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RailItem" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource ColorPanel}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>

    <Style x:Key="SectionPanel" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource ColorPanelAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ColorSeparator}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource ColorBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ColorPanel}" Padding="8,0,14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/logo.png" Width="50" Height="50" Stretch="Uniform" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Vincere Trading Ninja Manager"
                     Foreground="{StaticResource ColorAccent}"
                     FontSize="12"
                     FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Ellipse Width="11" Height="11" Fill="{StaticResource ColorWarning}" Margin="0,0,8,0"/>
            <TextBlock Text="First-time setup"
                       Foreground="{StaticResource ColorTextPrimary}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="License: required"
                     Foreground="{StaticResource ColorTextSecondary}"
                     Margin="0,0,24,0"/>
          <TextBlock Text="Setup Wizard"
                     Foreground="{StaticResource ColorAccent}"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource ColorBackground}"
              BorderBrush="{StaticResource ColorSeparator}"
              BorderThickness="0,0,1,0"
              Padding="10,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Setup Phase"
                     Foreground="{StaticResource ColorTextSecondary}"
                     FontWeight="SemiBold"
                     Margin="2,0,0,10"/>
          <StackPanel>
            <Border Style="{StaticResource RailItem}" Background="{StaticResource ColorAccent}">
              <StackPanel>
                <TextBlock Text="1  Welcome" FontWeight="SemiBold"/>
                <TextBlock Text="Client profile" FontSize="11" Foreground="#EAF6FF"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="2  License"/>
                <TextBlock Text="Whop verification" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="3  NT Settings"/>
                <TextBlock Text="Platform details" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="4  Prepare NT"/>
                <TextBlock Text="Templates and algos" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="5  Connections"/>
                <TextBlock Text="Prop firm accounts" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="6  Schedule"/>
                <TextBlock Text="Close-all default" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="7  Cycling"/>
                <TextBlock Text="Account cycling" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="8  Installing"/>
                <TextBlock Text="Apply setup" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource RailItem}">
              <StackPanel>
                <TextBlock Text="9  Complete"/>
                <TextBlock Text="Open dashboard" FontSize="11" Foreground="{StaticResource ColorTextSecondary}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="14,12,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ColorPanel}"
                BorderBrush="{StaticResource ColorSeparator}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Vincere Manager Setup"
                         FontSize="20"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Enter the client data needed before the dashboard and NinjaTrader automation are unlocked."
                         Foreground="{StaticResource ColorTextSecondary}"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{StaticResource ColorLogBackground}"
                    BorderBrush="{StaticResource ColorSeparator}"
                    BorderThickness="1"
                    Padding="14,8"
                    VerticalAlignment="Center">
              <TextBlock Text="100% hands-off mode"
                         Foreground="{StaticResource ColorAccent}"
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource SectionPanel}">
              <StackPanel>
                <TextBlock Text="Client Identity"
                           Foreground="{StaticResource ColorAccent}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Label Content="Trading platform"/>
                <TextBox x:Name="TradingPlatformBox" Text="NinjaTrader 8"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionPanel}">
              <StackPanel>
                <TextBlock Text="Optional NinjaTrader Login"
                           Foreground="{StaticResource ColorAccent}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <CheckBox x:Name="NinjaTraderAutoLoginCheck"
                          Content="Automatically open NinjaTrader and attempt login"
                          Margin="0,0,0,8"/>
                <TextBlock Text="Optional: use this only if the client wants hands-off startup. The password is encrypted for this Windows user and can be left blank to skip login automation."
                           Foreground="{StaticResource ColorWarning}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <Label Content="NinjaTrader username"/>
                    <TextBox x:Name="NinjaTraderUsernameBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Label Content="NinjaTrader password"/>
                    <PasswordBox x:Name="NinjaTraderPasswordBox"
                                 Background="{StaticResource ColorField}"
                                 Foreground="{StaticResource ColorTextPrimary}"
                                 BorderBrush="{StaticResource ColorSeparator}"
                                 Padding="8,5"
                                 MinHeight="30"/>
                  </StackPanel>
	                </Grid>
	                <CheckBox x:Name="NinjaTraderScheduledResetCheck"
	                          Content="Schedule NinjaTrader reset"
	                          Margin="0,12,0,6"/>
	                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
	                  <TextBlock Text="Reset every"
	                             Foreground="{StaticResource ColorTextSecondary}"
	                             VerticalAlignment="Center"
	                             Margin="0,0,8,0"/>
	                  <TextBox x:Name="NinjaTraderResetDaysBox"
	                           Text="7"
	                           Width="60"
	                           Margin="0,0,8,0"/>
	                  <TextBlock Text="day(s)"
	                             Foreground="{StaticResource ColorTextSecondary}"
	                             VerticalAlignment="Center"/>
	                </StackPanel>
	                <TextBlock Text="Scheduled reset shuts down and relaunches NinjaTrader before the morning connection refresh. Optional login is used only if enabled above."
	                           Foreground="{StaticResource ColorTextSecondary}"
	                           TextWrapping="Wrap"
	                           FontSize="12"/>
	              </StackPanel>
	            </Border>

            <Border Style="{StaticResource SectionPanel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="License Gate"
                             Foreground="{StaticResource ColorAccent}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Margin="0,0,0,10"/>
                  <Label Content="Vincere / Whop license key"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LicenseKeyBox"/>
                    <Button Grid.Column="1"
                            Content="Test License Key"
                            Width="145"
                            Margin="8,0,0,0"
                            Click="TestLicenseKey_Click"/>
                  </Grid>
                  <TextBlock x:Name="LicenseStatusText"
                             Text="License key has not been tested."
                             Foreground="{StaticResource ColorTextSecondary}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                  <TextBlock Text="The dashboard stays locked until this key verifies. Strategy templates will be stamped with this key during setup."
                             Foreground="{StaticResource ColorTextSecondary}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Reset invalid license key"
                        Width="190"
                        Height="36"
                        VerticalAlignment="Bottom"
                        Margin="18,0,0,0"
                        Click="OpenLicenseResetHelp_Click"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource SectionPanel}">
              <StackPanel>
                <TextBlock Text="Prop Firm Setup"
                           Foreground="{StaticResource ColorAccent}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <Label Content="Prop firm"/>
                    <TextBox x:Name="PropFirmBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Label Content="Account type"/>
                    <TextBox x:Name="AccountTypeBox"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <Label Content="Prop connection name"/>
                    <TextBox x:Name="PropConnBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Label Content="Account numbers (one per line)"/>
                    <TextBox x:Name="AccountsBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="96"
                             VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>
                <Border Background="{StaticResource ColorLogBackground}"
                        BorderBrush="{StaticResource ColorSeparator}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="NinjaTrader Discovery"
                               Foreground="{StaticResource ColorAccent}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,10">
                      <Button Content="Open NinjaTrader"
                              Click="OpenNinjaTrader_Click"
                              Width="135"
                              Margin="0,0,8,0"/>
                      <Button Content="Scan Prop Firms and Accounts"
                              Style="{StaticResource AccentButton}"
                              Click="ScanNinjaTrader_Click"
                              Width="220"/>
                    </WrapPanel>
                    <TextBlock x:Name="NinjaTraderScanStatusText"
                               Text="Step 1: open NinjaTrader. Step 2: scan the Control Center. Step 3: confirm the selected prop firms and accounts."
                               Foreground="{StaticResource ColorTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Available prop firms"
                                   Foreground="{StaticResource ColorTextSecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ListBox x:Name="DiscoveredPropConnectionsList"
                                 SelectionMode="Extended"
                                 Height="110"
                                 SelectionChanged="DiscoveredPropConnectionsList_SelectionChanged"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Available accounts"
                                   Foreground="{StaticResource ColorTextSecondary}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ListBox x:Name="DiscoveredAccountsList"
                                 SelectionMode="Extended"
                                 Height="110"
                                 SelectionChanged="DiscoveredAccountsList_SelectionChanged"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource ColorPanel}"
                BorderBrush="{StaticResource ColorSeparator}"
                BorderThickness="1"
                Padding="10"
                Margin="0,12,0,0">
          <Grid>
            <TextBlock Text="Ready"
                       Foreground="{StaticResource ColorTextSecondary}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancel"
                      Width="95"
                      Margin="0,0,8,0"
                      Click="Cancel_Click"/>
              <Button Content="Save &amp; continue"
                      Width="140"
                      Style="{StaticResource AccentButton}"
                      IsDefault="True"
                      Click="Save_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource ColorPanel}"
            BorderBrush="{StaticResource ColorSeparator}"
            BorderThickness="0,1,0,0"
            Padding="12,0">
      <Grid>
        <TextBlock Text="Setup"
                   Foreground="{StaticResource ColorAccent}"
                   VerticalAlignment="Center"/>
        <TextBlock Text="vincere-ops"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ColorTextSecondary}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
