<Window x:Class="Vincere.Operator.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincere — First-time setup" Height="520" Width="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Enter client-specific data stored only on this machine. You can add more accounts later in Settings."/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Label Content="Internal client id (optional)"/>
        <TextBox x:Name="ClientIdBox" />
        <Label Content="Account numbers (one per line)" Margin="0,12,0,0"/>
        <TextBox x:Name="AccountsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                 VerticalScrollBarVisibility="Auto"/>
        <Label Content="Prop connection name (exactly as in NinjaTrader Connections)" Margin="0,12,0,0"/>
        <TextBox x:Name="PropConnBox"/>
        <Label Content="Telegram bot token (optional)" Margin="0,12,0,0"/>
        <TextBox x:Name="TelegramTokenBox"/>
        <Label Content="Telegram chat id (optional)" Margin="0,12,0,0"/>
        <TextBox x:Name="TelegramChatBox"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Content="Save &amp; continue" Width="130" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
